{
  "name": "espansoedit",
  "version": "2.0.8",
  "private": true,
  "description": "Mac desktop shell for Espanso shortcut management.",
  "author": "Chris Mills",
  "main": "desktop/main.cjs",
  "scripts": {
    "frontend:build": "npm --prefix frontend run build",
    "desktop:icons": "node desktop/create-icons.cjs",
    "backend:build": "node desktop/build-backend.cjs",
    "backend:test-package": "node desktop/test-backend.cjs",
    "desktop:test": "node --test desktop/backend-client.test.cjs",
    "desktop:dev": "npm run frontend:build && npm run desktop:icons && electron .",
    "desktop:pack": "npm run frontend:build && npm run desktop:icons && npm run backend:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "desktop:dmg": "npm run frontend:build && npm run desktop:icons && npm run backend:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.chrismills.espansoedit",
    "productName": "EspansoEdit",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/espansoedit-backend",
        "to": "backend"
      },
      {
        "from": "frontend/dist",
        "to": "frontend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/icon.icns",
      "target": [
        "dir"
      ]
    },
    "dmg": {
      "icon": "desktop/assets/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
